@@ -0,0 +1,119 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\tool_belt_content\Kernel;
+
+use Drupal\language\Entity\ConfigurableLanguage;
+use Drupal\node\Entity\Node;
+use Drupal\path_alias\Entity\PathAlias;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests how the set field value tool handles path aliases without pathauto.
+ *
+ * @group tool_belt
+ */
+#[Group('tool_belt')]
+#[RunTestsInSeparateProcesses]
+class PathAliasTest extends OneShotEntityToolTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = ['path', 'path_alias', 'language'];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->installEntitySchema('path_alias');
+    ConfigurableLanguage::createFromLangcode('fr')->save();
+    $this->setUpCurrentUser([], ['access content', 'create page content', 'edit any page content']);
+  }
+
+  /**
+   * Follows one node through setting, updating and clearing its alias.
+   *
+   * One method, because each step depends on the state the previous one
+   * leaves, and every kernel test method boots a new container.
+   */
+  public function testAliasLifecycle(): void {
+    $node = Node::create(['type' => 'page', 'title' => 'Bonjour']);
+    $node->save();
+    $this->setPath($node, [['alias' => '/bonjour']]);
+    $node->set('langcode', 'fr');
+    $node->save();
+    $this->assertSame(['/bonjour' => 'fr'], $this->loadAliases($node), 'A first alias takes the language the entity has when it is saved, not when the tool ran.');
+
+    $this->setPath($node, [['alias' => '/second-alias']]);
+    $node->save();
+    $this->assertSame(['/second-alias' => 'fr'], $this->loadAliases($node), 'Setting an alias again updates it instead of adding another one.');
+
+    $this->setPath($node, [['alias' => '/third-alias', 'pid' => NULL, 'langcode' => NULL]]);
+    $node->save();
+    $this->assertSame(['/third-alias' => 'fr'], $this->loadAliases($node), 'A path ID the caller sent as NULL still updates the alias in place.');
+
+    $this->setPath($node, [['alias' => NULL]]);
+    $node->save();
+    $this->assertSame([], $this->loadAliases($node), 'A NULL alias removes the alias.');
+
+    $this->setPath($node, [['alias' => '/fourth-alias']]);
+    $node->save();
+    $this->setPath($node, []);
+    $node->save();
+    $this->assertSame([], $this->loadAliases($node), 'An empty value removes the alias.');
+
+    $this->setPath($node, [['alias' => '/fifth-alias']]);
+    $node->save();
+    $spare = PathAlias::create([
+      'path' => '/node/' . $node->id(),
+      'alias' => '/spare-alias',
+      'langcode' => 'fr',
+    ]);
+    $spare->save();
+    $this->setPath($node, [['alias' => '/updated-spare', 'pid' => (int) $spare->id()]]);
+    $node->save();
+    $this->assertSame(['/fifth-alias' => 'fr', '/updated-spare' => 'fr'], $this->loadAliases($node), 'A path ID passed by the caller is used as is, so the other alias is not changed.');
+  }
+
+  /**
+   * Sets the path field through the tool.
+   *
+   * @param \Drupal\node\Entity\Node $node
+   *   The node.
+   * @param array $value
+   *   The value to pass to the tool.
+   */
+  protected function setPath(Node $node, array $value): void {
+    $result = $this->runTool('tool_belt:field_set_value', [
+      'entity' => $node,
+      'field_name' => 'path',
+      'value' => $value,
+    ]);
+    $this->assertTrue($result->isSuccess(), (string) $result->getMessage());
+  }
+
+  /**
+   * Returns the aliases stored for a node, with their language, sorted.
+   *
+   * @param \Drupal\node\Entity\Node $node
+   *   The node.
+   *
+   * @return string[]
+   *   Langcodes keyed by alias.
+   */
+  protected function loadAliases(Node $node): array {
+    $storage = $this->container->get('entity_type.manager')->getStorage('path_alias');
+    $storage->resetCache();
+    $aliases = [];
+    foreach ($storage->loadByProperties(['path' => '/node/' . $node->id()]) as $path_alias) {
+      $aliases[$path_alias->getAlias()] = $path_alias->language()->getId();
+    }
+    ksort($aliases);
+    return $aliases;
+  }
+
+}
