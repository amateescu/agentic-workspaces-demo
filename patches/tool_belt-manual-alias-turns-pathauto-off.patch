diff --git a/modules/tool_belt_content/tests/src/Kernel/ManualPathAliasTest.php b/modules/tool_belt_content/tests/src/Kernel/ManualPathAliasTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..8cdef6060053c322b8eb8e6a83a141bb23cc2f3a
--- /dev/null
+++ b/modules/tool_belt_content/tests/src/Kernel/ManualPathAliasTest.php
@@ -0,0 +1,246 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\tool_belt_content\Kernel;
+
+use Drupal\language\Entity\ConfigurableLanguage;
+use Drupal\node\Entity\Node;
+use Drupal\node\NodeInterface;
+use Drupal\pathauto\Entity\PathautoPattern;
+use Drupal\pathauto\PathautoState;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests that pathauto does not replace an alias set through a tool.
+ *
+ * The entity passes through the tool handle store between the call that sets
+ * the alias and the call that saves it, which drops pathauto's own flag.
+ *
+ * @group tool_belt
+ */
+#[Group('tool_belt')]
+#[RunTestsInSeparateProcesses]
+class ManualPathAliasTest extends OneShotEntityToolTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = ['path', 'path_alias', 'token', 'pathauto', 'language', 'content_translation'];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->installEntitySchema('path_alias');
+    // Token's node tokens ask the date formatter for a format.
+    $this->installConfig(['system', 'pathauto']);
+    PathautoPattern::create([
+      'id' => 'node_title',
+      'type' => 'canonical_entities:node',
+      'pattern' => '/[node:title]',
+    ])->save();
+    ConfigurableLanguage::createFromLangcode('fr')->save();
+    $this->container->get('content_translation.manager')->setEnabled('node', 'page', TRUE);
+    $this->setUpCurrentUser([], ['access content', 'create page content', 'edit any page content']);
+  }
+
+  /**
+   * Follows one node through setting, keeping and clearing its alias.
+   *
+   * One method, because each step depends on the state the previous one
+   * leaves, and every kernel test method boots a new container.
+   */
+  public function testAliasLifecycle(): void {
+    $generated = $this->generated('Generated Title');
+
+    $node = Node::create(['type' => 'page', 'title' => 'Generated Title']);
+    $node = $this->setAliasAndSave($node, '/set-by-tool');
+    $this->assertAliases(['/set-by-tool'], $node, 'An alias set on a new entity is used instead of the pattern.');
+
+    $node = $this->setAliasAndSave($node, '');
+    $this->assertAliases([$generated], $node, 'Clearing an alias set by the tool turns pathauto back on.');
+
+    $node = $this->setAliasAndSave($node, '');
+    $this->assertAliases([$generated], $node, 'Clearing an alias generated by pathauto changes nothing.');
+
+    $this->setAlias($node, '/set-by-tool');
+    $node = $this->roundTrip($node);
+    $node->set('path', ['alias' => '/set-elsewhere']);
+    $node->save();
+    $this->assertAliases([$generated], $node, 'An alias changed after the tool ran goes through the ordinary save path, and pathauto regenerates its alias.');
+
+    // The translation steps run while pathauto still generates the alias,
+    // since a node with a tool-set alias gets none for a new translation.
+    $translation = $node->addTranslation('fr', ['title' => 'Titre Francais']);
+    $translation->save();
+    $this->assertAliases([$generated, $this->generated('Titre Francais')], $node, 'A new translation gets a generated alias.');
+
+    $this->setAlias($translation, '');
+    $node = $this->roundTrip($node);
+    $node->save();
+    $this->assertAliases([$generated], $node, 'Clearing a translation the save does not go through removes its alias.');
+
+    // Pathauto keeps one state per entity, so that clear turned it off for
+    // the English alias too, the same as the form would have. A fresh load,
+    // since the in-memory item still caches the state it computed earlier.
+    $storage = $this->container->get('entity_type.manager')->getStorage('node');
+    $storage->resetCache();
+    $node = $storage->load($node->id());
+    $node->setTitle('Renamed Title');
+    $node->save();
+    $this->assertAliases([$generated], $node, 'The English alias is no longer regenerated.');
+
+    $translation = $node->getTranslation('fr');
+    $translation->set('path', ['alias' => '/fr-by-hand']);
+    $translation->save();
+    $this->setAlias($translation, '/alias-francais');
+    $node = $this->roundTrip($node);
+    $node->save();
+    $this->assertAliases(['/alias-francais', $generated], $node, 'An alias set on a translation is updated in place when the save goes through another translation.');
+
+    $this->setAlias($node, '/set-by-tool');
+    $node = $this->roundTrip($node);
+    $storage->resetCache();
+    $storage->load($node->id())->save();
+    $node->save();
+    $this->assertAliases(['/alias-francais', '/set-by-tool'], $node, 'An alias set on a saved entity replaces the existing one, even when someone else saves the node in the meantime.');
+
+    $node->setTitle('Another Title');
+    $node->save();
+    $this->assertAliases(['/alias-francais', '/set-by-tool'], $node, 'A later save does not change a tool-set alias.');
+
+    // A fresh node, since its in-memory item has no alias ID: pathauto wrote
+    // the alias itself.
+    $other = Node::create(['type' => 'page', 'title' => 'Other Title']);
+    $other->save();
+    $this->assertAliases([$this->generated('Other Title')], $other, 'The second node gets a generated alias.');
+    PathautoPattern::load('node_title')->delete();
+    $other = $this->setAliasAndSave($other, '');
+    $this->assertAliases([], $other, 'Clearing removes the alias when no pattern applies.');
+  }
+
+  /**
+   * Tests that an alias set by the tool but never saved does not apply later.
+   */
+  public function testUnsavedAliasDoesNotOverrideLaterSave(): void {
+    $node = Node::create([
+      'type' => 'page',
+      'title' => 'Generated Title',
+      'path' => ['alias' => '/manual', 'pathauto' => PathautoState::SKIP],
+    ]);
+    $node->save();
+
+    // The tool sets the node's existing alias, and that entity is never
+    // saved.
+    $this->setAlias($node, '/manual');
+
+    $storage = $this->container->get('entity_type.manager')->getStorage('node');
+    $storage->resetCache();
+    $edited = $storage->load($node->id());
+    $edited->get('path')->first()->set('pathauto', PathautoState::CREATE);
+    $edited->save();
+    $this->assertAliases([$this->generated('Generated Title')], $edited, 'An editor who turns pathauto on gets a generated alias.');
+  }
+
+  /**
+   * Returns the alias pathauto generates for a title under the test pattern.
+   *
+   * @param string $title
+   *   The node title.
+   *
+   * @return string
+   *   The generated alias.
+   */
+  protected function generated(string $title): string {
+    return '/' . $this->container->get('pathauto.alias_cleaner')->cleanString($title);
+  }
+
+  /**
+   * Asserts the aliases stored for a node.
+   *
+   * @param string[] $expected
+   *   The expected aliases, sorted.
+   * @param \Drupal\node\NodeInterface $node
+   *   The node.
+   * @param string $step
+   *   What the step was meant to show.
+   */
+  protected function assertAliases(array $expected, NodeInterface $node, string $step): void {
+    $this->assertSame($expected, $this->loadAliases($node), $step);
+  }
+
+  /**
+   * Sets an alias through the tool.
+   *
+   * @param \Drupal\node\NodeInterface $node
+   *   The node, or one of its translations.
+   * @param string $alias
+   *   The alias to set; an empty string clears it.
+   */
+  protected function setAlias(NodeInterface $node, string $alias): void {
+    $result = $this->runTool('tool_belt:field_set_value', [
+      'entity' => $node,
+      'field_name' => 'path',
+      'value' => [['alias' => $alias]],
+    ]);
+    $this->assertTrue($result->isSuccess(), (string) $result->getMessage());
+  }
+
+  /**
+   * Sets an alias through the tool and saves the node as the next call would.
+   *
+   * @param \Drupal\node\NodeInterface $node
+   *   The node.
+   * @param string $alias
+   *   The alias to set; an empty string clears it.
+   *
+   * @return \Drupal\node\NodeInterface
+   *   The node after the round trip through the handle store and the save.
+   */
+  protected function setAliasAndSave(NodeInterface $node, string $alias): NodeInterface {
+    $this->setAlias($node, $alias);
+    $node = $this->roundTrip($node);
+    $node->save();
+    return $node;
+  }
+
+  /**
+   * Stores a node in the tool handle store and reads it back.
+   *
+   * @param \Drupal\node\NodeInterface $node
+   *   The node to pass through the store.
+   *
+   * @return \Drupal\node\NodeInterface
+   *   The node as the next tool call would receive it.
+   */
+  protected function roundTrip(NodeInterface $node): NodeInterface {
+    $handle_store = $this->container->get('tool.handle_store');
+    $node = $handle_store->resolve($handle_store->store($node));
+    $this->assertInstanceOf(NodeInterface::class, $node);
+    return $node;
+  }
+
+  /**
+   * Returns the aliases stored for a node, sorted.
+   *
+   * @param \Drupal\node\NodeInterface $node
+   *   The node.
+   *
+   * @return string[]
+   *   The aliases pointing at the node.
+   */
+  protected function loadAliases(NodeInterface $node): array {
+    $storage = $this->container->get('entity_type.manager')->getStorage('path_alias');
+    $storage->resetCache();
+    $aliases = [];
+    foreach ($storage->loadByProperties(['path' => '/node/' . $node->id()]) as $path_alias) {
+      $aliases[] = $path_alias->getAlias();
+    }
+    sort($aliases);
+    return $aliases;
+  }
+
+}
