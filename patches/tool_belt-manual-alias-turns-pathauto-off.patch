+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\tool_belt_content\Hook;
+
+use Drupal\Core\Entity\EntityInterface;
+use Drupal\Core\Entity\ContentEntityInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\tool_belt_content\ManualPathAlias;
+
+/**
+ * Applies aliases set through a tool when their entity is saved.
+ */
+final class ManualPathAliasHooks {
+
+  public function __construct(
+    private readonly ManualPathAlias $manualPathAlias,
+  ) {}
+
+  /**
+   * Implements hook_entity_presave().
+   */
+  #[Hook('entity_presave')]
+  public function entityPresave(EntityInterface $entity): void {
+    if ($entity instanceof ContentEntityInterface) {
+      $this->manualPathAlias->apply($entity);
+    }
+  }
+
+}
diff --git a/modules/tool_belt_content/src/ManualPathAlias.php b/modules/tool_belt_content/src/ManualPathAlias.php
new file mode 100644
index 0000000000000000000000000000000000000000..2e82729b622442a2361d5f04d0a22679f6e00e7f
--- /dev/null
+++ b/modules/tool_belt_content/src/ManualPathAlias.php
@@ -0,0 +1,244 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\tool_belt_content;
+
+use Drupal\Core\Entity\ContentEntityInterface;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Field\FieldItemInterface;
+use Drupal\path_alias\AliasRepositoryInterface;
+use Drupal\pathauto\PathautoState;
+
+/**
+ * Makes an alias set through a tool behave like one typed into the form.
+ *
+ * A new alias replaces the entity's existing alias instead of being added
+ * next to it, and pathauto must not overwrite it. Clearing the alias turns
+ * pathauto back on for the entity, so it generates a new alias if a pattern
+ * applies and removes the old one otherwise. Pathauto stores its state per
+ * entity, not per translation, so turning it on or off for one translation
+ * turns it on or off for all of them. The form has the same behavior.
+ *
+ * None of that can be done when the tool runs. The item may not have the
+ * existing alias ID, and pathauto's flag is a computed property that is lost
+ * when the entity is serialized into the tool handle tempstore. So the tool
+ * records the alias on the entity and this applies it on presave.
+ */
+final class ManualPathAlias {
+
+  /**
+   * The non-field entity value that holds the recorded aliases.
+   *
+   * Non-field values are serialized with the entity, so the record survives
+   * the tool handle store. Only the entity object changed by the tool has
+   * the record, so a save of the same entity loaded elsewhere is not
+   * affected.
+   */
+  private const PROPERTY = '_toolBeltManualPathAliases';
+
+  public function __construct(
+    private readonly EntityTypeManagerInterface $entityTypeManager,
+    private readonly ?AliasRepositoryInterface $aliasRepository = NULL,
+  ) {}
+
+  /**
+   * Adds the current alias ID to a value that clears the alias.
+   *
+   * NULL, an empty list and an item with an empty or NULL alias all count as
+   * a clear.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity translation the value is for.
+   * @param string $field_name
+   *   The name of the path field.
+   * @param mixed $value
+   *   The value passed to the tool.
+   *
+   * @return mixed
+   *   The value to set on the entity.
+   */
+  public function keepIdOnClear(ContentEntityInterface $entity, string $field_name, mixed $value): mixed {
+    if ($value === NULL || $value === []) {
+      $value = [['alias' => '']];
+    }
+    if (!is_array($value) || !isset($value[0]) || !is_array($value[0])) {
+      return $value;
+    }
+    if (trim((string) ($value[0]['alias'] ?? '')) !== '' || !empty($value[0]['pid'])) {
+      return $value;
+    }
+    $value[0]['alias'] = '';
+
+    // Without the ID the item is empty. FieldItemList::preSave() then filters
+    // it out before any hook runs, so the alias would never be removed.
+    $item = $entity->get($field_name)->first();
+    $current = $item ? $this->currentAlias($item, $entity) : NULL;
+    if ($current === NULL) {
+      return $value;
+    }
+    $value[0]['pid'] = $current['id'];
+    $value[0]['langcode'] = $current['langcode'];
+    return $value;
+  }
+
+  /**
+   * Records the alias a tool set on an entity, or that the tool cleared it.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity translation the alias was set on.
+   * @param string $field_name
+   *   The name of the path field.
+   */
+  public function record(ContentEntityInterface $entity, string $field_name): void {
+    // Translations share non-field values, so this is the record for all of
+    // them.
+    /** @var array<string, array<string, string>> $aliases */
+    $aliases = $entity->{self::PROPERTY} ?? [];
+    $langcode = $entity->language()->getId();
+
+    $item = $entity->get($field_name)->first();
+    if ($item === NULL || $item->isEmpty()) {
+      // An empty item is filtered out on save, so there is nothing to apply.
+      unset($aliases[$langcode][$field_name]);
+    }
+    else {
+      // PathItem::preSave() trims the alias before apply() compares it, so
+      // trim here too.
+      $aliases[$langcode][$field_name] = trim((string) $item->get('alias')->getValue());
+    }
+    if (($aliases[$langcode] ?? NULL) === []) {
+      unset($aliases[$langcode]);
+    }
+
+    if ($aliases === []) {
+      unset($entity->{self::PROPERTY});
+      return;
+    }
+    // PHPStan reads every magic entity property as a field.
+    // @phpstan-ignore assign.propertyType
+    $entity->{self::PROPERTY} = $aliases;
+  }
+
+  /**
+   * Applies the recorded aliases when the entity is saved.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity being saved.
+   */
+  public function apply(ContentEntityInterface $entity): void {
+    /** @var array<string, array<string, string>>|null $aliases */
+    $aliases = $entity->{self::PROPERTY} ?? NULL;
+    if ($aliases === NULL) {
+      return;
+    }
+    // The record only applies to the save that follows the tool call.
+    unset($entity->{self::PROPERTY});
+
+    // Core saves the path items of every translation, not just the one this
+    // hook received, so every translation in the record is checked. Pathauto
+    // only regenerates the active translation.
+    $active_langcode = $entity->language()->getId();
+    foreach ($aliases as $langcode => $fields) {
+      if (!$entity->hasTranslation($langcode)) {
+        continue;
+      }
+      $translation = $entity->getTranslation($langcode);
+
+      foreach ($fields as $field_name => $alias) {
+        if (!$translation->hasField($field_name)) {
+          continue;
+        }
+        foreach ($translation->get($field_name) as $item) {
+          // An alias that changed after the tool set it is saved as is.
+          if ($item->get('alias')->getValue() !== $alias) {
+            continue;
+          }
+          $this->applyToItem($item, $translation, $langcode === $active_langcode);
+        }
+      }
+    }
+  }
+
+  /**
+   * Sets the alias ID and the pathauto state on one item.
+   *
+   * @param \Drupal\Core\Field\FieldItemInterface $item
+   *   The path field item.
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity translation being saved.
+   * @param bool $is_active
+   *   Whether that translation is the active one on the entity being saved.
+   */
+  private function applyToItem(FieldItemInterface $item, ContentEntityInterface $entity, bool $is_active): void {
+    // Pathauto is optional. instanceof does not autoload the class, so this
+    // works without it.
+    $pathauto = $item->getProperties(TRUE)['pathauto'] ?? NULL;
+    if (!$pathauto instanceof PathautoState) {
+      $pathauto = NULL;
+    }
+
+    if ((string) $item->get('alias')->getValue() === '') {
+      // The alias is deleted here instead of in PathItem::postSave(). That
+      // delete branch keeps the ID of the deleted alias on the item, and the
+      // next save of the same object fails on it. The alias is looked up
+      // again because the ID the tool stored may be outdated by now.
+      $current = $this->currentAlias($item, $entity);
+      if ($current !== NULL) {
+        $storage = $this->entityTypeManager->getStorage('path_alias');
+        $storage->delete(array_filter([$storage->load($current['id'])]));
+      }
+      $item->set('pid', NULL);
+
+      if ($pathauto === NULL) {
+        return;
+      }
+      if ($is_active) {
+        // Purging the stored state makes pathauto decide again on this save.
+        // With a matching pattern it generates a new alias.
+        $pathauto->purge();
+      }
+      else {
+        // Pathauto only regenerates the active translation, so for the others
+        // a clear just removes the alias.
+        $pathauto->setValue(PathautoState::SKIP);
+      }
+      return;
+    }
+
+    // Without the ID, PathItem::postSave() creates a second path_alias entity
+    // and keeps the old one. The item only has the ID if the entity was
+    // loaded after the alias was written. An entity pathauto aliased on its
+    // last save was not. The stored langcode is copied too, so the update
+    // does not change the alias language.
+    if (empty($item->get('pid')->getValue())) {
+      $current = $this->currentAlias($item, $entity);
+      if ($current !== NULL) {
+        $item->set('pid', $current['id']);
+        $item->set('langcode', $current['langcode']);
+      }
+    }
+    $pathauto?->setValue(PathautoState::SKIP);
+  }
+
+  /**
+   * Looks up the alias the entity has in the item's language.
+   *
+   * @param \Drupal\Core\Field\FieldItemInterface $item
+   *   The path field item.
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity translation the item belongs to.
+   *
+   * @return array|null
+   *   The repository row ('id', 'path', 'alias', 'langcode'), or NULL if there
+   *   is none.
+   */
+  private function currentAlias(FieldItemInterface $item, ContentEntityInterface $entity): ?array {
+    if ($this->aliasRepository === NULL || $entity->isNew() || !$entity->hasLinkTemplate('canonical')) {
+      return NULL;
+    }
+    $langcode = $item->get('langcode')->getValue() ?: $item->getLangcode();
+    return $this->aliasRepository->lookupBySystemPath('/' . $entity->toUrl()->getInternalPath(), $langcode) ?: NULL;
+  }
+
+}
