+  /**
+   * Tests an alias change in Live after a workspace changed the same alias.
+   */
+  public function testPathAliasUpdateInLiveReusesWorkspaceRedirect(): void {
+    $this->initializeWorkspacesModule();
+    /** @var \Drupal\redirect\RedirectRepository $repository */
+    $repository = \Drupal::service('redirect.repository');
+
+    $path_alias = PathAlias::create([
+      'path' => '/user/1',
+      'alias' => '/old-alias',
+      'langcode' => 'en',
+    ]);
+    $path_alias->save();
+
+    // The workspace creates a redirect from the old alias. Live sees it as
+    // disabled until the workspace is published.
+    $this->switchToWorkspace('stage');
+    $this->updatePathAlias($path_alias->id(), '/stage-alias');
+    $stage_redirect = $repository->findMatchingRedirect('old-alias', [], 'en');
+    $this->assertNotNull($stage_redirect);
+
+    $this->switchToLive();
+    $this->assertNull($repository->findMatchingRedirect('old-alias', [], 'en'));
+    $this->updatePathAlias($path_alias->id(), '/live-alias');
+
+    $live_redirect = $repository->findMatchingRedirect('old-alias', [], 'en');
+    $this->assertNotNull($live_redirect);
+    $this->assertEquals($stage_redirect->id(), $live_redirect->id());
+    $this->assertSame('internal:/user/1', $live_redirect->getRedirect()['uri']);
+
+    $this->workspaces['stage']->publish();
+    $this->assertSourceRedirectCount(1, 'old-alias');
+    /** @var \Drupal\redirect\Entity\Redirect $redirect */
+    $redirect = \Drupal::entityTypeManager()->getStorage('redirect')->loadUnchanged($stage_redirect->id());
+    $this->assertTrue($redirect->isPublished());
+  }
+
+  /**
+   * Tests an alias change in a workspace after another workspace changed it.
+   */
+  public function testPathAliasUpdateInWorkspaceReusesOtherWorkspaceRedirect(): void {
+    $this->initializeWorkspacesModule();
+    $other = Workspace::create(['id' => 'other', 'label' => 'Other']);
+    $other->save();
+    /** @var \Drupal\redirect\RedirectRepository $repository */
+    $repository = \Drupal::service('redirect.repository');
+
+    $path_alias = PathAlias::create([
+      'path' => '/user/1',
+      'alias' => '/old-alias',
+      'langcode' => 'en',
+    ]);
+    $path_alias->save();
+
+    $this->switchToWorkspace('stage');
+    $this->updatePathAlias($path_alias->id(), '/stage-alias');
+    $stage_redirect = $repository->findMatchingRedirect('old-alias', [], 'en');
+    $this->assertNotNull($stage_redirect);
+
+    $this->switchToWorkspace('other');
+    $this->assertNull($repository->findMatchingRedirect('old-alias', [], 'en'));
+    $this->updatePathAlias($path_alias->id(), '/other-alias');
+    $other_redirect = $repository->findMatchingRedirect('old-alias', [], 'en');
+    $this->assertNotNull($other_redirect);
+    $this->assertEquals($stage_redirect->id(), $other_redirect->id());
+
+    // Live is not affected until a workspace is published.
+    $this->switchToLive();
+    $this->assertNull($repository->findMatchingRedirect('old-alias', [], 'en'));
+
+    $this->workspaces['stage']->publish();
+    $other->publish();
+    $this->assertSourceRedirectCount(1, 'old-alias');
+    $this->assertNotNull($repository->findMatchingRedirect('old-alias', [], 'en'));
+  }
+
+  /**
+   * Changes a path alias in the active workspace or in Live.
+   *
+   * @param int|string $id
+   *   The path alias ID.
+   * @param string $alias
+   *   The new alias.
+   */
+  protected function updatePathAlias(int|string $id, string $alias): void {
+    /** @var \Drupal\path_alias\PathAliasInterface $path_alias */
+    $path_alias = \Drupal::entityTypeManager()->getStorage('path_alias')->loadUnchanged($id);
+    $path_alias->setAlias($alias);
+    $path_alias->save();
+  }
+
+  /**
+   * Asserts how many redirects have a source path, in the active context.
+   *
+   * @param int $expected
+   *   The expected number of redirects.
+   * @param string $source_path
+   *   The source path.
+   */
+  protected function assertSourceRedirectCount(int $expected, string $source_path): void {
+    $ids = \Drupal::entityTypeManager()->getStorage('redirect')->getQuery()
+      ->accessCheck(FALSE)
+      ->condition('redirect_source.path', $source_path)
+      ->execute();
+    $this->assertCount($expected, $ids);
+  }
