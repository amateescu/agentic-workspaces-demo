+  /**
+   * Test redirect entity revisions.
+   */
+  public function testRedirectRevisions(): void {
+    /** @var \Drupal\Core\Entity\ContentEntityStorageInterface $storage */
+    $storage = $this->container->get('entity_type.manager')->getStorage('redirect');
+    /** @var \Drupal\redirect\Entity\Redirect $redirect */
+    $redirect = $storage->create();
+
+    $redirect->setSource('some-url', ['revision' => 'default']);
+    $redirect->setRedirect('admin');
+    $redirect->save();
+    $this->assertEquals(Redirect::generateHash('some-url', ['revision' => 'default'], Language::LANGCODE_NOT_SPECIFIED), $redirect->getHash());
+
+    // Create a pending revision for the redirect and check if hash has been
+    // updated as expected.
+    $redirect->setSource('some-url', ['revision' => 'pending']);
+    $redirect->setNewRevision();
+    $redirect->isDefaultRevision(FALSE);
+    $redirect->save();
+
+    $this->assertEquals(2, $redirect->getRevisionId());
+    $this->assertFalse($redirect->isDefaultRevision());
+    $this->assertEquals(Redirect::generateHash('some-url', ['revision' => 'pending'], Language::LANGCODE_NOT_SPECIFIED), $redirect->getHash());
+
+    // Check that the hash of the default revision has not been changed.
+    /** @var \Drupal\redirect\Entity\Redirect $redirect */
+    $redirect = $storage->loadUnchanged($redirect->id());
+    $this->assertEquals(Redirect::generateHash('some-url', ['revision' => 'default'], Language::LANGCODE_NOT_SPECIFIED), $redirect->getHash());
+
+    // Check that the redirect repository still finds the default revision.
+    /** @var \Drupal\redirect\RedirectRepository $repository */
+    $repository = \Drupal::service('redirect.repository');
+    $redirect = $repository->findMatchingRedirect('some-url', ['revision' => 'default']);
+    $this->assertNotNull($redirect);
+    $this->assertEquals('/some-url?revision=default', $redirect->getSourceUrl());
+
+    // Make the pending revision the default one and check that the hash is
+    // correct.
+    $redirect = $storage->loadRevision(2);
+    $redirect->setNewRevision();
+    $redirect->isDefaultRevision(TRUE);
+    $redirect->save();
+
+    /** @var \Drupal\redirect\Entity\Redirect $redirect */
+    $redirect = $storage->loadUnchanged($redirect->id());
+    $this->assertEquals(3, $redirect->getRevisionId());
+    $this->assertTrue($redirect->isDefaultRevision());
+    $this->assertEquals(Redirect::generateHash('some-url', ['revision' => 'pending'], Language::LANGCODE_NOT_SPECIFIED), $redirect->getHash());
+  }
