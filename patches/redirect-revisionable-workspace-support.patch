+  /**
+   * Test redirect entity logic in a workspace.
+   */
+  public function testRedirectWithWorkspaces(): void {
+    $this->initializeWorkspacesModule();
+    $this->switchToWorkspace('stage');
+
+    // Execute an existing test method in the context of an active workspace.
+    $this->testRedirectEntity();
+
+    /** @var \Drupal\redirect\RedirectRepository $repository */
+    $repository = \Drupal::service('redirect.repository');
+
+    // Check that the redirects created inside a workspace are not available in
+    // Live.
+    $this->switchToLive();
+
+    $redirect = $repository->findMatchingRedirect('another-url', ['key1' => 'val1'], 'de');
+    $this->assertNull($redirect);
+    $redirect = $repository->findMatchingRedirect('a-different-url', ['key1' => 'val1'], 'de');
+    $this->assertNull($redirect);
+    $redirect = $repository->findMatchingRedirect('google');
+    $this->assertNull($redirect);
+    $redirect = $repository->findMatchingRedirect('case-sensitive-path');
+    $this->assertNull($redirect);
+
+    // Publish the workspace and check that the redirects are now available in
+    // Live.
+    $this->workspaces['stage']->publish();
+
+    $redirect = $repository->findMatchingRedirect('another-url', ['key1' => 'val1'], 'de');
+    $this->assertNotNull($redirect);
+    $redirect = $repository->findMatchingRedirect('a-different-url', ['key1' => 'val1'], 'de');
+    $this->assertNotNull($redirect);
+    $redirect = $repository->findMatchingRedirect('google');
+    $this->assertNotNull($redirect);
+    $redirect = $repository->findMatchingRedirect('case-sensitive-path');
+    $this->assertNotNull($redirect);
+  }
